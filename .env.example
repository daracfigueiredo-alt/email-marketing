# Banco de dados
DATABASE_URL="postgresql://usuario:senha@localhost:5432/email_marketing?schema=public"

# NextAuth
NEXTAUTH_SECRET="gere-um-valor-aleatorio-seguro"
NEXTAUTH_URL="http://localhost:3000"

# Chave usada para cifrar os refresh_tokens das contas de e-mail conectadas (AES-256-GCM)
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=""

# Gmail API (OAuth 2.0) - nunca exponha no frontend
# Necessário para o fluxo "Conectar conta Gmail" em Configurações
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI="http://localhost:3000/api/integrations/gmail/callback"
# Modo legado (uma única conta sem passar pela tela de Configurações):
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER_EMAIL=""

# Outlook / Microsoft 365 (OAuth 2.0 via Microsoft identity platform)
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
OUTLOOK_REDIRECT_URI="http://localhost:3000/api/integrations/outlook/callback"
OUTLOOK_TENANT="common"

# ChatGuru
CHATGURU_API_KEY=""
CHATGURU_ACCOUNT_ID=""
CHATGURU_BASE_URL="https://s##.chatguru.app/api/v1"
# ID do aparelho/WhatsApp conectado à conta (necessário quando a conta tem mais de um número)
CHATGURU_PHONE_ID=""

# Planilha de leads (Google Sheets) — a cada ciclo de automação, importa como Lead
# qualquer linha sem status "enviado" (dedupe por e-mail/telefone), e depois de
# enviar marca a coluna de status como "enviado" (opcional; deixe LEADS_SHEET_ID
# vazio para desativar).
LEADS_SHEET_ID=""
LEADS_SHEET_ABA=""
LEADS_SHEET_COLUNA_EMAIL="D"
LEADS_SHEET_COLUNA_NOME="E"
LEADS_SHEET_COLUNA_TELEFONE="F"
LEADS_SHEET_COLUNA_EMPRESA="G"
LEADS_SHEET_COLUNA_STATUS="H"
# Campanha à qual os novos leads da planilha são atribuídos automaticamente
LEADS_SHEET_CAMPANHA_ID=""

# Cenário no Make.com "Resposta de Lead - E-mail Marketing App": quando um lead
# responde, avisa (anotação no ChatGuru + cópia por e-mail ao responsável + WhatsApp
# interno). Deixe vazio para desativar essa notificação sem remover o código.
MAKE_WEBHOOK_RESPOSTA_LEAD_URL=""

# Vercel Blob (armazenamento privado dos anexos — substitui a pasta uploads/ local)
BLOB_READ_WRITE_TOKEN=""

# Automação
REMARKETING_INTERVAL_DAYS=3
# Segredo usado pelo cron externo para chamar POST /api/automacoes/run
AUTOMACAO_SECRET=""

# Sincronização DFLINE (planilha "funil 2.1" → card no funil "Card criado/novo")
# O cenário Make.com "1 - Cadastro ChatGuru" chama POST /api/dfline-sync/webhook
# a cada lead novo — confira esse segredo no header Authorization: Bearer.
DFLINE_SYNC_WEBHOOK_SECRET=""
# Tenant (escritório) e destino do card criado automaticamente
DFLINE_OFFICE_ID="OC_CRM.html"
DFLINE_FUNIL_NOVO_LEAD_ID="funil_1787751154367"
DFLINE_COLUNA_NOVO_LEAD_ID="novo_lead_1787751154367"

# Firebase Admin SDK — service account com acesso ao Firestore do DFLINE (projeto
# df-crm-14fac). Gerar no Console do Firebase: Configurações do projeto > Contas de
# serviço > Gerar nova chave privada. NUNCA commitar o JSON baixado nem colar aqui —
# preencha só localmente/no ambiente do deploy. FIREBASE_ADMIN_PRIVATE_KEY é o campo
# "private_key" do JSON, colado como uma linha só (mantendo os "\n" literais).
FIREBASE_ADMIN_PROJECT_ID="df-crm-14fac"
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# 55PBX (ligação individual — já nativo no DFLINE; credenciais reais ficam só aqui,
# nunca em código. Cadastrar também em DFLINE → Configurações → Integrações → 55PBX
# por SDR, com o e-mail do ramal de cada um)
PBX55_CLIENT_CODE=""
PBX55_API_KEY=""
PBX55_BASE_URL="https://ws.55pbx.com:20500/api/pbx/webphone/dial"

# Botão "Enviar para E-mail Marketing" no card do DFLINE (POST /api/leads/importar-dfline,
# chamado direto do navegador do SDR — por isso libera CORS). O segredo fica visível no
# código-fonte do DFLINE, é só uma barreira simples, não uma autenticação forte.
DFLINE_LEAD_IMPORT_SECRET=""
# Campanha deste app que recebe os leads enviados pelo botão (opcional — sem isso o
# lead só é cadastrado, sem entrar automaticamente em nenhuma sequência de remarketing)
DFLINE_REMARKETING_CAMPANHA_ID=""
